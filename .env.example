# ============================================================
# KAIRÓS — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or .env.local to version control.
# ============================================================

# Supabase (auto-generated by OnSpace — do not modify)
VITE_SUPABASE_URL=https://your-project.backend.onspace.ai
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Admin secret key — stored in Supabase Edge Function Secrets
# Set via: Supabase Dashboard > Edge Functions > Secrets
# ADMIN_SECRET_KEY=your_very_long_random_secret_here

# Email service (optional — for send-email Edge Function)
# RESEND_API_KEY=re_your_resend_key_here

# Exchange rates API (optional — for currency conversion)
# EXCHANGE_RATE_API_KEY=your_key_here
